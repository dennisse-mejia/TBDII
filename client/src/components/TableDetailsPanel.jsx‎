import React from "react";

function bool(v) {
  return v === true || v === 1 || v === "1";
}

function Badge({ children, title }) {
  return (
    <span
      title={title}
      style={{
        fontSize: 12,
        fontWeight: 800,
        padding: "2px 8px",
        borderRadius: 999,
        border: "1px solid rgba(255,255,255,0.16)",
        background: "rgba(255,255,255,0.06)",
      }}
    >
      {children}
    </span>
  );
}

function IndexesList({ rows }) {
  // agrupa filas en un indice
  const map = new Map();

  for (const r of rows) {
    const name = r.index_name || "(sin nombre)";
    if (!map.has(name)) {
      map.set(name, {
        name,
        type: r.type_desc,
        isUnique: bool(r.is_unique),
        isPk: bool(r.is_primary_key),
        isUq: bool(r.is_unique_constraint),
        hasFilter: bool(r.has_filter),
        filter: r.filter_definition || null,
        keys: [],
        included: [],
      });
    }

    const it = map.get(name);

    if (bool(r.is_included_column)) {
      it.included.push(r.column_name);
    } else {
      it.keys.push({
        col: r.column_name,
        ord: r.key_ordinal ?? 0,
        desc: bool(r.is_descending_key),
      });
    }
  }

  const list = Array.from(map.values()).map((it) => ({
    ...it,
    keys: it.keys.sort((a, b) => a.ord - b.ord),
    included: Array.from(new Set(it.included)),
  }));

  return (
    <div style={{ display: "grid", gap: 8, marginTop: 10 }}>
      {list.map((idx) => (
        <div
          key={idx.name}
          style={{
            border: "1px solid rgba(255,255,255,0.10)",
            borderRadius: 12,
            padding: 10,
            background: "rgba(255,255,255,0.02)",
            display: "grid",
            gap: 6,
          }}
        >
          <div style={{ display: "flex", gap: 10, alignItems: "center" }}>
            <span style={{ fontWeight: 900 }}>{idx.name}</span>
            <span style={{ opacity: 0.7 }}>{idx.type}</span>

            <span style={{ marginLeft: "auto", display: "flex", gap: 6 }}>
              {idx.isPk ? <Badge title="Primary Key">PK</Badge> : null}
              {idx.isUnique ? <Badge title="Unique">UNIQUE</Badge> : null}
              {idx.isUq ? <Badge title="Unique Constraint">UQ</Badge> : null}
              {idx.hasFilter ? <Badge title="Filtered index">FILTER</Badge> : null}
            </span>
          </div>

          <div style={{ opacity: 0.9 }}>
            <b>Keys:</b>{" "}
            {idx.keys
              .map((k) => `${k.col} ${k.desc ? "DESC" : "ASC"}`)
              .join(", ")}
          </div>

          {idx.included.length ? (
            <div style={{ opacity: 0.85 }}>
              <b>Included:</b> {idx.included.join(", ")}
            </div>
          ) : null}

          {idx.filter ? (
            <div style={{ opacity: 0.85 }}>
              <b>Filter:</b> {idx.filter}
            </div>
          ) : null}
        </div>
      ))}
    </div>
  );
}


export default function TableDetailsPanel({
  selected,
  details,
  loading,
  error,
  indexes,
  loadingIndexes,
  indexesError,
  onClear,
}) {

  return (
    <section
      style={{
        border: "1px solid rgba(255,255,255,0.12)",
        background: "rgba(255,255,255,0.03)",
        borderRadius: 12,
        padding: 14,
        marginBottom: 18,
      }}
    >
      <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
        <h2 style={{ margin: 0 }}>Detalle</h2>

        <div
          style={{
            marginLeft: "auto",
            display: "flex",
            gap: 8,
            alignItems: "center",
          }}
        >
          {selected ? (
            <span style={{ opacity: 0.8, fontWeight: 800 }}>
              {selected.schema}.{selected.name}
            </span>
          ) : (
            <span style={{ opacity: 0.6 }}>— selecciona una tabla —</span>
          )}

          {selected ? (
            <button onClick={onClear} style={{ padding: "8px 10px", fontWeight: 800 }}>
              Limpiar
            </button>
          ) : null}
        </div>
      </div>

      {loading ? (
        <p style={{ marginTop: 10, opacity: 0.8 }}>Cargando detalle...</p>
      ) : error ? (
        <p style={{ marginTop: 10, color: "tomato", fontWeight: 800 }}>{error}</p>
      ) : !selected ? null : !details ? (
        <p style={{ marginTop: 10, opacity: 0.8 }}>Sin datos aún.</p>
      ) : (
        <div style={{ marginTop: 12, display: "grid", gap: 12 }}>
          <div style={{ display: "flex", gap: 8, flexWrap: "wrap", alignItems: "center" }}>
            <Badge title="Primary Key">PK: {details.primaryKey?.name ?? "—"}</Badge>
            {(details.primaryKey?.columns ?? []).length ? (
              <span style={{ opacity: 0.8, fontSize: 13 }}>
                ({details.primaryKey.columns.map((c) => c.name).join(", ")})
              </span>
            ) : (
              <span style={{ opacity: 0.6, fontSize: 13 }}>(sin columnas PK)</span>
            )}
          </div>

          <div style={{ overflowX: "auto" }}>
            <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 13 }}>
              <thead>
                <tr style={{ textAlign: "left", opacity: 0.85 }}>
                  <th style={{ padding: "8px 6px" }}>Columna</th>
                  <th style={{ padding: "8px 6px" }}>Tipo</th>
                  <th style={{ padding: "8px 6px" }}>Null</th>
                  <th style={{ padding: "8px 6px" }}>Identity</th>
                  <th style={{ padding: "8px 6px" }}>PK</th>
                </tr>
              </thead>

              <tbody>
                {(details.columns ?? []).map((c) => {
                  const isPk = bool(c.is_pk);
                  const isId = bool(c.is_identity);
                  const isNull = bool(c.is_nullable);

                  const typeExtra =
                    c.type_name === "nvarchar" ||
                    c.type_name === "varchar" ||
                    c.type_name === "char" ||
                    c.type_name === "nchar"
                      ? `(${c.max_length})`
                      : c.type_name === "decimal" || c.type_name === "numeric"
                      ? `(${c.precision},${c.scale})`
                      : "";

                  return (
                    <tr
                      key={c.column_id ?? c.column_name}
                      style={{ borderTop: "1px solid rgba(255,255,255,0.08)" }}
                    >
                      <td style={{ padding: "8px 6px", fontWeight: 800 }}>
                        {c.column_name}
                      </td>

                      <td style={{ padding: "8px 6px", opacity: 0.9 }}>
                        {c.type_name}
                        {typeExtra}
                      </td>

                      <td style={{ padding: "8px 6px" }}>{isNull ? "Sí" : "No"}</td>

                      <td style={{ padding: "8px 6px" }}>
                        {isId ? (
                          <Badge title={`seed=${c.seed_value} inc=${c.increment_value}`}>
                            Sí
                          </Badge>
                        ) : (
                          "—"
                        )}
                      </td>

                      <td style={{ padding: "8px 6px" }}>
                        {isPk ? <Badge title={`orden ${c.pk_ordinal ?? ""}`}>Sí</Badge> : "—"}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

                    {/* indices */}
          <div style={{ marginTop: 6 }}>
            <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
              <h3 style={{ margin: 0 }}>Indexes</h3>

              {loadingIndexes ? (
                <span style={{ opacity: 0.7 }}>cargando…</span>
              ) : (
                <span style={{ opacity: 0.7 }}>{(indexes ?? []).length}</span>
              )}
            </div>

            {indexesError ? (
              <p style={{ marginTop: 10, color: "tomato", fontWeight: 800 }}>
                {indexesError}
              </p>
            ) : loadingIndexes ? (
              <p style={{ marginTop: 10, opacity: 0.8 }}>Cargando índices...</p>
            ) : (indexes ?? []).length === 0 ? (
              <p style={{ marginTop: 10, opacity: 0.7 }}>— sin índices —</p>
            ) : (
              <pre style={{ marginTop: 10, whiteSpace: "pre-wrap", opacity: 0.9 }}>
                {JSON.stringify(indexes, null, 2)}
              </pre>
            )}
          </div>

        </div>
      )}
    </section>
  );
}